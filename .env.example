# Exact hostnames allowed for API test execution. Empty means no outbound test requests.
# Use comma-separated hostnames only; do not include schemes or paths.
TESTPILOT_ALLOWED_HOSTS=

# Set to true only when your explicitly allowed API is served over plain HTTP.
TESTPILOT_ALLOW_HTTP=false

TESTPILOT_DB_PATH=backend/data/testpilot.sqlite3

# Google OAuth credentials are created in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
TESTPILOT_FRONTEND_URL=http://127.0.0.1:5173
TESTPILOT_OWNER_EMAIL=tiwarishashwat36@gmail.com
# Generate a unique value of at least 32 characters. Set COOKIE_SECURE=true in production HTTPS.
TESTPILOT_SESSION_SECRET=
TESTPILOT_COOKIE_SECURE=false

# Optional. Keep this key on the backend; never put it in a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Frontend dev origin; comma-separated if you need another local origin.
TESTPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
